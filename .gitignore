# Build output. Regenerated by build.bat / build.ps1 -- never committed.
# The shipped .exe is published as a GitHub Release asset instead, because Git
# stores every version of a binary forever and would bloat the repo.
build/
dist/
dist_installer/
release/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Generated icon/asset previews
assets/_*.png

# Local runtime data (databases, unlocked output). Never belongs in the repo.
*.db
*.sqlite
*.sqlite3
unlocked/

# Optional bundled qpdf binaries -- see tools/qpdf/README.txt
tools/qpdf/bin/
tools/qpdf/lib/
tools/qpdf/share/

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# Updater scratch
remote_version.txt
DocCipherBreaker.new
DocCipherBreaker_old.exe
*.exe.old
